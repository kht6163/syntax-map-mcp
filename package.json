{
  "name": "syntax-map-mcp",
  "version": "0.1.9",
  "description": "Tree-sitter based code analysis MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "syntax-map-mcp": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kht6163/syntax-map-mcp.git"
  },
  "homepage": "https://github.com/kht6163/syntax-map-mcp#readme",
  "bugs": {
    "url": "https://github.com/kht6163/syntax-map-mcp/issues"
  },
  "files": [
    "dist",
    "docs/tools.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "npm run typecheck && npm test && npm run build && node scripts/check-package-files.mjs && node scripts/smoke-package-install.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/sql.js": "^1.4.11",
    "ignore": "^7.0.5",
    "sql.js": "^1.14.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "express-rate-limit": "7.5.1"
  }
}
